fn demo -> unit
 ex sort [3 1 2] = [1 2 3]
 ex else at [10 20] 1 0 = 20
 ex at [10] 2 = none i64
 ex slice [1 2 3 4] 1 3 = [2 3]
 ex push [1 2] 3 = [1 2 3]
 ex rev [1 2 3] = [3 2 1]
 ex sum [1 2 3] = 6
 ex float "1.5" = ok 1.5
 ex else float "x" 0.0 = 0.0
 ex and true false = false
 ex or false true = true
 ex not false = true
 ex neg 5 = -5
 ex == 2 2 = true
 ex != 2 3 = true
 nil
fn main -> unit
 print show sort [3 1 2]
