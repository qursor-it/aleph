fn diff a:i64 b:i64 -> i64
 ex diff 1 4 = 3
 abs - a b
fn main -> unit
 do print show abs -5
 do print show abs 7
 do print show abs -2.5
 do print show abs -0.0
 do print show min 3 1
 do print show max 3 1
 do print show min 1.5 0.5
 do print show max -1.5 -0.5
 do print show min 2 2
 do print show starts "hello" "he"
 do print show starts "he" "hello"
 do print show ends "hello" "lo"
 do print show ends "hello" "he"
 do print show starts "abc" ""
 do print show uniq [3 1 3 2 1]
 do print show uniq ["b" "a" "b"]
 do print show uniq empty i64
 do print show uniq [1.0 -0.0 0.0 1.0]
 do print show map2 @diff [1 2 3] [4 0]
 do print show map2 @diff empty i64 [1]
 do print show map @abs [-1 2]
 do print show fold @max 0 [3 9 2]
 do print show fold @min 9 [3 1 2]
 nil
