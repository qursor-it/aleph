fn addnum acc:res list i64 str s:str -> res list i64 str
 ex addnum ok [1] "2" = ok [1 2]
 ex addnum err "x" "2" = err "x"
 ex addnum ok [1] "x" = err "invalid int"
 let base try acc
 let n try int s
 ok push base n
fn emit text:str -> res unit str
 ex emit "x" = ok nil
 do print text
 ok nil
fn max2 a:i64 b:i64 -> i64
 ex max2 1 3 = 3
 if > a b a b
fn maxof xs:list i64 -> i64
 ex maxof [1 3 2] = 3
 ex maxof [-5 -2] = -2
 fold @max2 else at xs 0 0 xs
fn min2 a:i64 b:i64 -> i64
 ex min2 1 3 = 1
 if < a b a b
fn minof xs:list i64 -> i64
 ex minof [1 3 2] = 1
 ex minof [-5 -2] = -5
 fold @min2 else at xs 0 0 xs
fn nolist -> res list i64 str
 ex nolist = ok empty i64
 ok empty i64
fn numbers xs:list str -> res list i64 str
 ex numbers ["1" "2"] = ok [1 2]
 ex numbers empty str = ok empty i64
 fold @addnum nolist xs
fn report xs:list i64 -> str
 ex report [1 2 3] = "max 3 min 1"
 cat cat "max " show maxof xs cat " min " show minof xs
fn main -> res unit str
 let xs try numbers args
 if == 0 len xs err "no numbers" emit report xs
