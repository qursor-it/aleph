fn checked xs:list i64 -> res i64 str
 ex checked [1 2] = ok 2
 ex checked [1 5] = err "big"
 fold lam a x if > x 3 err "big" ok x ok 0 xs
fn wrap xs:list i64 -> list res i64 str
 ex wrap [1] = [ok 1]
 map lam x ok x xs
fn main -> unit
 do print show len wrap [1 2 3]
 do print show else checked [1 2] 0
 print show isok checked [1 9]
