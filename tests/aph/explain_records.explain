capabilities: none
type point x:f64 y:f64
fn origin -> point
  doc: -
  effectful: no
  examples: origin = point 0.0 0.0
  calls: -
  builtins: -
fn shift p:point dx:f64 dy:f64 -> point
  doc: "translate a point"
  effectful: no
  examples: shift point 1.0 2.0 3.0 4.0 = point 4.0 6.0
  calls: -
  builtins: -
fn main -> unit
  doc: -
  effectful: yes
  examples: -
  calls: shift
  builtins: print show
entry: main
