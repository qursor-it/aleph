use fs.read "data.csv"
fn main -> res unit str
 let text try read "data.csv"
 let lines filter lam s > count s 0 split text "\n"
 let header else at lines 0 ""
 let idx else index split header "," else at args 0 "" -1
 let cells map lam row else at split row "," idx "" slice lines 1 len lines
 let n try if < idx 0 err "column not found" mapr @int cells
 do print show sum n
 ok nil
