use fs.read "data"
fn lines text:str -> i64
 ex lines "a\n\nb" = 2
 ex lines "" = 0
 len filter @nonempty split text "\n"
fn nonempty s:str -> bool
 ex nonempty "" = false
 ex nonempty " " = false
 ex nonempty "x" = true
 > count trim s 0
fn main -> res unit str
 let text try read "data/in.txt"
 do print show lines text
 ok nil
