use fs.read "text.txt"
fn main -> res unit str
 let text try read "text.txt"
 let c fold lam a w put a w + 1 else get a w 0 dict str i64 fields text
 let ws slice sortby lam w neg else get c w 0 keys c 0 3
 if == 0 len ws ok nil
 do print join map lam w join [w show else get c w 0] " " ws "\n"
 ok nil
