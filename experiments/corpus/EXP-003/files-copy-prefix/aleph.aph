use fs.read "in.txt"
use fs.write "out.txt"
fn collect prefix:str text:str -> str
 ex collect "a" "ab\nx\n" = "ab\n"
 join map lam line cat line "\n" filter lam line and > count line 0 starts line prefix split text "\n" ""
fn main -> res unit str
 let text try read "in.txt"
 let prefix else at args 0 ""
 let saved try write "out.txt" collect prefix text
 ok nil
