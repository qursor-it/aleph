type point x:f64 y:f64
fn dist a:point b:point -> f64
 ex dist point 0.0 0.0 point 3.0 4.0 = 5.0
 let dx - .x a .x b
 let dy - .y a .y b
 sqrt + * dx dx * dy dy
fn perimeter xs:list point -> f64
 ex perimeter [point 0.0 0.0 point 3.0 0.0 point 3.0 4.0] = 12.0
 fold lam a d + a d 0.0 map2 @dist xs cat slice xs 1 len xs slice xs 0 1
fn main -> unit
 let polygon [point 0.0 0.0 point 3.0 0.0 point 3.0 4.0]
 print show perimeter polygon
