fn addtext acc:res i64 str s:str -> res i64 str
 ex addtext ok 1 "2" = ok 3
 ex addtext err "x" "2" = err "x"
 ex addtext ok 1 "x" = err "invalid int"
 let base try acc
 let n try int s
 ok + base n
fn total xs:list str -> res i64 str
 ex total ["1" "2" "3"] = ok 6
 ex total empty str = ok 0
 fold @addtext zero xs
fn zero -> res i64 str
 ex zero = ok 0
 ok 0
fn main -> res unit str
 let n try total args
 do print show n
 ok nil
