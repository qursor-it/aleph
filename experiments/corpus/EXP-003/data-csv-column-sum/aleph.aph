use fs.read "data.csv"
fn main -> res unit str
 let text try read "data.csv"
 let lines filter lam s > count s 0 split text "\n"
 let idx try okor index split else at lines 0 "" "," else at args 0 "" "column not found"
 let n try mapr lam row int else at split row "," idx "" slice lines 1 len lines
 do print show sum n
 ok nil
